# Notion Sync 环境变量配置示例
# 复制此文件为 .env 并填入你的实际值

# Notion API 集成密钥 (从 https://www.notion.so/my-integrations 获取)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 数据库 ID (从数据库 URL 中提取)
DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Notion 登录 Cookie (用于代理下载过期图片)
# 从浏览器 F12 → Application → Cookies → www.notion.so → token_v2 获取
NOTION_TOKEN_V2=v02%3Auser_token_data...

# Google Drive 目标文件夹 ID (从文件夹 URL 中提取)
DRIVE_FOLDER_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ

# Google 服务账号凭据 JSON 文件路径
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json

# 可选：是否覆盖已存在的文件 (true/false)
OVERWRITE_EXISTING=false

# 可选：是否使用状态过滤器 (true/false)
USE_STATUS_FILTER=true

# 可选：GitHub Personal Access Token（用于自动刷新 GOOGLE_TOKEN_JSON Secret）
# 需要拥有 repo 范围的权限（该范围已包含对仓库 Secrets 的写入权限）
# 在 GitHub 仓库的 Settings → Secrets → Actions 中配置，名称为 GH_PAT
# 若不配置，token 刷新后仅在当次 Actions 运行中生效，下次运行仍需手动更新
# GH_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
